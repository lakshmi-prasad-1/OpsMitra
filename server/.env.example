PORT=4000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0

# OpsMitra stores data in SQLite (a file under server/data/ by default). MySQL support ended after Phase 4;
# use `npm run migrate:mysql-to-sqlite --prefix server` to move an old MySQL database.
DB_DRIVER=sqlite
SQLITE_PATH=data/opsmitra.sqlite

JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=8h

# Optional: Claude-powered "Ask OpsMitra" assistant. Leave empty to use the built-in engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Prototype convenience: the forgot-password link is shown on screen and logged instead of emailed.
# Always off when NODE_ENV=production unless set to "true" explicitly.
PROTOTYPE_RESET_LINKS=true

# Sign-in/registration attempts allowed per IP per 15 minutes.
AUTH_MAX_ATTEMPTS=30

# Serve the built React app (client/dist) from this process too. Set to false when nginx serves it.
SERVE_CLIENT=true

# Read-only source credentials for the one-off MySQL-to-SQLite import command.
MYSQL_SOURCE_HOST=localhost
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_USER=replace_with_database_user
MYSQL_SOURCE_PASSWORD=replace_with_database_password
MYSQL_SOURCE_NAME=opsmitra
