# Copy to .env in the project root before using docker compose.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
CLIENT_ORIGIN=http://localhost:8080

# Optional: enables the Claude-powered assistant (otherwise the built-in engine answers questions).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# Prototype convenience: show password-reset links on screen (no email service). Set to false for real use.
PROTOTYPE_RESET_LINKS=true
